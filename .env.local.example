# ======================================================================
# RouteIQ — Environment Variables
# Copy this file to .env (not .env.local) for docker-compose to read it
# ======================================================================

# --- Google Maps ---
# One key covers: Maps JS, Geocoding, Roads, Routes, Distance Matrix
# Enable all 6 APIs in Google Cloud Console for this key
GOOGLE_MAPS_API_KEY=

# --- Routing Backend ---
# Set automatically by docker-compose (http://backend:8000)
# Override here only if running frontend outside Docker
# BACKEND_URL=http://localhost:8000

# --- OSRM (optional) ---
# Leave blank to use public demo server. Set to self-hosted for production.
# OSRM_BASE_URL=http://your-osrm-server:5000

# --- Firebase (client-side) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (server-side API routes) ---
# Paste your service account JSON as a single-line minified string
FIREBASE_SERVICE_ACCOUNT=

# --- FieldRoutes ---
FIELDROUTES_AUTH_KEY=
FIELDROUTES_AUTH_TOKEN=
FIELDROUTES_NWA_BASE_URL=https://flexpc.fieldroutes.com/api
FIELDROUTES_GENERAL_PEST_SERVICE_ID=1

# --- Stripe ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
